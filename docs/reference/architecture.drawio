        <mxCell id="c22" value="&lt;b&gt;aws_route_table.public&lt;/b&gt; · {name}-public-rt&lt;br&gt;&lt;b&gt;aws_route.public_internet&lt;/b&gt;&lt;br&gt;0.0.0.0/0 → internet gateway&lt;br&gt;shared by every public subnet" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.route_table;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=2;" vertex="1" parent="1">
