        <mxCell id="c2" value="terraform-aws-vpc — architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="A VPC with public and private subnets across zones, one route table per tier, a NAT gateway and flow logs, with the default security group emptied." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#545B64;spacing=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1354" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;&lt;b&gt;name&lt;/b&gt; — required&lt;br&gt;&lt;b&gt;cidr_block&lt;/b&gt; — required&lt;br&gt;public_subnet_cidrs = []&lt;br&gt;private_subnet_cidrs = []&lt;br&gt;availability_zones = null&lt;br&gt;nat_gateway_mode = &quot;single&quot;&lt;br&gt;flow_logs_enabled = true&lt;br&gt;flow_logs_traffic_type = &quot;ALL&quot;&lt;br&gt;flow_logs_max_aggregation_interval = 60&lt;br&gt;flow_logs_retention_in_days = 365&lt;br&gt;flow_logs_kms_key_arn = null&lt;br&gt;manage_default_security_group = true&lt;br&gt;public_subnet_tags = {}&lt;br&gt;private_subnet_tags = {}&lt;br&gt;tags = {}" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="280" height="243" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;vpc_id&lt;br&gt;vpc_arn&lt;br&gt;vpc_cidr_block&lt;br&gt;availability_zones&lt;br&gt;public_subnet_ids&lt;br&gt;private_subnet_ids&lt;br&gt;public_route_table_ids&lt;br&gt;private_route_table_ids&lt;br&gt;internet_gateway_id&lt;br&gt;nat_gateway_id&lt;br&gt;nat_public_ip&lt;br&gt;default_security_group_id&lt;br&gt;flow_log_group_name" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEF6E8;strokeColor=#7AA116;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="100" width="294" height="214" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;IAM the module creates&lt;/b&gt;&lt;br&gt;aws_iam_role.flow_logs — trusted by vpc-flow-logs.amazonaws.com only when aws:SourceAccount is the caller's and aws:SourceArn matches arn:{partition}:ec2:{region}:{account}:vpc-flow-log/*.&lt;br&gt;Inline policy deliver-flow-logs: logs:CreateLogStream, logs:PutLogEvents, logs:DescribeLogGroups and logs:DescribeLogStreams on the flow-log group's streams." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDF2F4;strokeColor=#DD344C;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="330" width="294" height="161" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;Requirements&lt;/b&gt;&lt;br&gt;Terraform ≥ 1.9.0 · hashicorp/aws ≥ 6.24&lt;br&gt;No provider block: the caller's provider sets the account, the Region and default_tags." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="507" width="294" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="Only when … — created only when the condition holds" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=2;fontSize=10;fontColor=#232F3E;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1320" y="599" width="294" height="34" as="geometry" />
