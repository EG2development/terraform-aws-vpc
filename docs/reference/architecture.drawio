        <mxCell id="c23" value="&lt;b&gt;aws_route_table.private&lt;/b&gt; · {name}-private-rt&lt;br&gt;&lt;b&gt;aws_route.private_nat&lt;/b&gt;&lt;br&gt;0.0.0.0/0 → NAT gateway&lt;br&gt;shared by every private subnet" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.route_table;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=2;" vertex="1" parent="1">
          <mxGeometry x="715" y="716" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="Only when manage_default_security_group = true (default)" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=2;fontSize=10;fontColor=#232F3E;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1040" y="190" width="235" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;b&gt;aws_default_security_group.main&lt;/b&gt;&lt;br&gt;{name}-default-deny: every rule removed, so nothing that falls back to the default group can talk" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#545B64;spacing=4;" vertex="1" parent="c24">
          <mxGeometry x="6" y="32" width="225" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="Only when flow_logs_enabled = true (default)" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=2;fontSize=10;fontColor=#232F3E;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1040" y="330" width="235" height="510" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="&lt;b&gt;aws_flow_log.main&lt;/b&gt;&lt;br&gt;flow_logs_traffic_type ALL&lt;br&gt;60-second aggregation" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.flow_logs;" vertex="1" parent="c26">
          <mxGeometry x="92" y="40" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="&lt;b&gt;aws_cloudwatch_log_group.flow_logs&lt;/b&gt;&lt;br&gt;/vpc/{name}/flow-logs&lt;br&gt;365 days · optional KMS key" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" vertex="1" parent="c26">
          <mxGeometry x="92" y="190" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;b&gt;aws_iam_role.flow_logs&lt;/b&gt;&lt;br&gt;{name}-vpc-flow-logs&lt;br&gt;+ inline policy deliver-flow-logs" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.role;" vertex="1" parent="c26">
          <mxGeometry x="92" y="350" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="all traffic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.2;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="&lt;b&gt;nat_gateway_mode&lt;/b&gt;&lt;br&gt;• single (default) — one NAT gateway and Elastic IP in public subnet 1: every private subnet's outbound traffic depends on zone 1.&lt;br&gt;• regional — one Regional NAT gateway attached to the VPC, which AWS spreads across zones; needs hashicorp/aws ≥ 6.24.&lt;br&gt;• none — no NAT gateway and no default route in the private route table.&lt;br&gt;Subnet n is placed in zone n: supply one CIDR per tier for each zone you want, up to the Region's number of zones." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#545B64;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="360" y="856" width="910" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c32" value="Source: main.tf, flow_logs.tf, variables.tf and outputs.tf in this repository, as of the version this diagram was drawn for. Edit architecture.drawio in draw.io and export architecture.png beside it (File › Export as › PNG)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#545B64;spacing=4;fontSize=10;fontColor=#879196;" vertex="1" parent="1">
          <mxGeometry x="40" y="982" width="1574" height="22" as="geometry" />
        </mxCell>
      </root>
